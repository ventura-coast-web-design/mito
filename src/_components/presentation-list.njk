<section id="ubicaciones" class="section locations" aria-labelledby="locations-title">
  <div class="container">
    <header class="section__head">
      <h2 id="locations-title">DÓNDE SE REALIZARÁN LAS CLASES</h2>
    </header>

    <div class="locations__map-wrap">
      <div
        id="locations-map"
        class="locations__map"
        data-locale="es"
        role="region"
        aria-label="Mapa de ubicaciones de las clases en California"
      ></div>
      <script type="application/json" id="locations-map-data">{{ cities | locationsMapData | safe }}</script>
      <p class="locations__map-hint">Toca un marcador para ver detalles e inscripción.</p>
    </div>

    <div class="locations__group" aria-labelledby="spanish-classes-title">
      <h3 id="spanish-classes-title" class="locations__group-title">en Español</h3>
      <p class="locations__group-lede">
      </p>
      <ul class="locations__list" role="list">
        {% for place in cities %}
          {% if place.language == "es" %}
            <li class="location-card location-card--featured">
              <p class="location-card__badge">Clase en español</p>
              {% if place.zoom %}
                <p class="location-card__zoom">
                  <span class="location-card__zoom-dot" aria-hidden="true"></span>
                  {% if place.zoom.url %}
                    <a href="{{ place.zoom.url }}" rel="noopener noreferrer">{{ place.zoom.linkLabel or "Unirse por Zoom" }}</a>
                  {% else %}
                    También disponible por Zoom
                  {% endif %}
                </p>
              {% endif %}
              <h4 class="location-card__title">
                {{ place.city }}{% if place.region %}, {{ place.region }}{% endif %}
                {% if place.sessions and place.sessions[0] and place.sessions[0].date %}
                  <span class="location-card__date">{{ place.sessions[0].date }}</span>
                {% endif %}
              </h4>
              {% if place.venueName %}
                <p class="location-card__venue">{{ place.venueName }}</p>
              {% endif %}
              <address class="location-card__address">
                {% for line in place.addressLines %}
                  {{ line }}{% if not loop.last %}<br />{% endif %}
                {% endfor %}
              </address>
              <p class="location-card__actions">
                <a href="/local-presentations/{{ place.slug }}/"><button class="btn btn--primary" type="button">Inscríbete</button></a>
                {% if place.zoom and place.zoom.url %}
                  <a class="location-card__link location-card__link--primary" href="{{ place.zoom.url }}" rel="noopener noreferrer">
                    {{ place.zoom.linkLabel or "Unirse por Zoom" }}
                  </a>
                {% endif %}
                <a class="location-card__link location-card__link--primary" href="/local-presentations/{{ place.slug }}/">
                  Detalles del lugar
                </a>
                {% if place.mapUrl %}
                  <a class="location-card__link" href="{{ place.mapUrl }}" rel="noopener noreferrer">Abrir en Maps</a>
                {% endif %}
              </p>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <div class="locations__group" aria-labelledby="english-classes-title">
      <h3 id="english-classes-title" class="locations__group-title">In English</h3>
      <ul class="locations__list" role="list">
        {% for place in cities %}
          {% if place.language != "es" %}
            <li class="location-card">
              <h4 class="location-card__title">
                {{ place.city }}{% if place.region %}, {{ place.region }}{% endif %}
                {% if place.sessions and place.sessions[0] and place.sessions[0].date %}
                  <span class="location-card__date">{{ place.sessions[0].date }}</span>
                {% endif %}
              </h4>
              {% if place.venueName %}
                <p class="location-card__venue">{{ place.venueName }}</p>
              {% endif %}
              <address class="location-card__address">
                {% for line in place.addressLines %}
                  {{ line }}{% if not loop.last %}<br />{% endif %}
                {% endfor %}
              </address>
              <p class="location-card__actions">
                <a href="/local-presentations/{{ place.slug }}/"><button class="btn btn--primary" type="button">Inscríbete</button></a>
                <a class="location-card__link location-card__link--primary" href="/local-presentations/{{ place.slug }}/">
                  Detalles del lugar
                </a>
                {% if place.mapUrl %}
                  <a class="location-card__link" href="{{ place.mapUrl }}" rel="noopener noreferrer">Abrir en Maps</a>
                {% endif %}
              </p>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
